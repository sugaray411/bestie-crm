# ---------------------------------------------------------------------------
# Database: the dedicated least-privilege role, through the Supabase
# TRANSACTION POOLER (port 6543) -- not a direct session connection, and never
# the app's service_role key.
# ---------------------------------------------------------------------------
CRM_DATABASE_URL=postgres://crm_service:<password>@<project>.pooler.supabase.com:6543/postgres?sslmode=require
CRM_DB_POOL_MAX=5

# ---------------------------------------------------------------------------
# Copy generation
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
COPY_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Channels. Leave any of these blank and that channel refuses to send while
# dry runs keep working -- useful for a read-only or planning-only deployment.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Signing secret from the Resend webhook you create (starts with whsec_).
# Without it the delivery/bounce/complaint webhook returns 503 and message
# statuses never advance past "sent".
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Bestie <hello@bestie.app>
TWILIO_ACCOUNT_SID=
# Also used to verify inbound Twilio webhook signatures.
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# stdio (Claude Desktop/Code), http (hosted), or both.
CRM_TRANSPORT=stdio
CRM_HTTP_PORT=8787
# Required for the HTTP transport and POST /crm/ingest. Also the HMAC secret for
# unsubscribe and bulk-approval tokens, so changing it invalidates outstanding
# unsubscribe links.
CRM_MCP_BEARER_TOKEN=
# Recorded in crm.audit_log as the actor behind each mutation.
CRM_ACTOR=mcp-agent
# The externally reachable base URL of THIS server. Required to verify Twilio
# signatures, which are computed over the exact URL Twilio called.
CRM_PUBLIC_URL=https://crm.bestie.app
# Drain crm.events_inbox on a timer. 0 disables it — leave it off if the app
# posts to /crm/ingest instead of inserting into the landing table.
CRM_DRAIN_INTERVAL_SECONDS=0

# ---------------------------------------------------------------------------
# Guardrails (§7). These are enforced in code; changing them changes behaviour.
# ---------------------------------------------------------------------------
BULK_APPROVAL_THRESHOLD=200
FREQUENCY_CAP=2
FREQUENCY_WINDOW_DAYS=7
DAILY_SPEND_CEILING_USD=50
SEND_RATE_PER_MINUTE=60
QUIET_HOURS_START=9
QUIET_HOURS_END=20

# Both are REQUIRED for email: without them every email send is blocked,
# because CAN-SPAM requires a working unsubscribe link and a postal address.
SENDER_PHYSICAL_ADDRESS=
# Must point at THIS server's /u route (directly, or via a proxy/CNAME from
# your marketing domain). The links are dead otherwise.
UNSUBSCRIBE_BASE_URL=https://crm.bestie.app/u
# Optional mailto: added to the List-Unsubscribe header alongside the URL.
UNSUBSCRIBE_MAILTO=unsubscribe@bestie.app
