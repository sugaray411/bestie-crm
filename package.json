{
  "name": "bestie-growth-crm",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for consent-gated growth and customer-acquisition operations for the AI Bestie app.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bestie-growth-crm": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "migrate": "node dist/db/migrate.js",
    "demo": "node scripts/demo.mjs",
    "verify": "node scripts/verify-send-paths.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
